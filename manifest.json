{
  "manifest_version": 3,
  "name": "FocusTube",
  "version": "1.0",
  "description": "Focus on YouTube videos by hiding all distractions",
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "toggle-focus": {
      "suggested_key": {
        "default": "Alt+Z"
      },
      "description": "Toggle Focus Mode"
    }
  },
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "activeTab"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
